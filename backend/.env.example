# Copy to .env and fill in. The app auto-selects an LLM engine: Gemini if a
# GEMINI_API_KEY is set, then Claude if ANTHROPIC_API_KEY is set, else the
# offline rule/TF-IDF engine (degraded but fully functional, air-gapped-safe).

# ── Database ──────────────────────────────────────────────────────────────────
# Omit → SQLite (auto-created as complaints.db next to this file, local dev only)
# AWS RDS: postgresql://user:password@<endpoint>:5432/complaints
# Docker local: postgresql://complaints:complaints@localhost:5432/complaints
DATABASE_URL=

# ── LLM engine ────────────────────────────────────────────────────────────────
# Engine: "auto" (default) | "gemini" | "claude" | "ollama" | "rules"
LLM_PROVIDER=gemini

# Gemini — primary NLP engine (NLU on Flash Lite + semantic embeddings)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001

# Claude (alternative demo-quality NLU provider)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-8

# Production sovereign provider (self-hosted open-weight model via Ollama).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
