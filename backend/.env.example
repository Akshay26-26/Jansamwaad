# Copy to .env and fill in.  If ANTHROPIC_API_KEY is unset, the backend
# automatically falls back to the offline rule-based provider (degraded but
# fully functional) — useful for air-gapped / low-resource demos.

# LLM provider: "auto" (default) | "claude" | "rules" | "ollama"
LLM_PROVIDER=auto

# Demo-quality provider
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-8

# Production sovereign provider (self-hosted open-weight model via Ollama).
# Set LLM_PROVIDER=ollama to use. No citizen data leaves the box.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
